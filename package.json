{
  "name": "pulse-player",
  "productName": "PulsePlayer",
  "version": "1.0.0",
  "description": "本地音乐播放器 — 三套风格 20 套节奏脉冲可视化 · 沉浸全屏",
  "main": "src/main/main.js",
  "version": "1.1.0",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js",
    "test:renderer": "electron ./selftest --disable-gpu --no-sandbox",
    "test:all": "node test/core.test.js && electron ./selftest --disable-gpu --no-sandbox",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --win portable --x64"
  },
  "author": "PulsePlayer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pulseplayer.app",
    "productName": "PulsePlayer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PulsePlayer"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}